#!/bin/sh
# Connectivity watchdog for rm520n — runs as a procd-managed daemon.
# Polls the configured host every <interval> seconds. On <threshold> consecutive
# failures triggers the configured action. Cascade mode escalates in three
# stages: reconnect -> reboot_modem -> reboot_router, one stage per threshold
# hit, as long as connectivity keeps failing.

FAIL_FILE="/tmp/rm520n_watchdog_fails"
STAGE_FILE="/tmp/rm520n_watchdog_stage"
LAST_OK_FILE="/tmp/rm520n_watchdog_last_ok"
COUNTERS_FILE="/tmp/rm520n_watchdog_counters"

_cfg() { uci -q get "rm520n.watchdog.$1" 2>/dev/null; }

# One-line signal snapshot taken via the existing rpcd refresh() call, so
# every logged action carries the connection state that led to it — makes
# the history log useful for diagnosing whether failures correlate with
# poor signal, PSU quality, traffic load, or NR SCC state.
_signal_snapshot() {
    local raw tech rsrp sinr rrc mv tx rx prev_tx prev_rx dtx drx
    local i type band crsrp scc

    raw="$(ubus call rm520n refresh 2>/dev/null)"
    if [ -z "$raw" ]; then
        printf 'signal=unavailable'
        return
    fi
    tech="$(printf '%s' "$raw" | jsonfilter -e '@.technology' 2>/dev/null)"
    rsrp="$(printf '%s' "$raw" | jsonfilter -e '@.rsrp'       2>/dev/null)"
    sinr="$(printf '%s' "$raw" | jsonfilter -e '@.sinr'       2>/dev/null)"
    rrc="$( printf '%s' "$raw" | jsonfilter -e '@.rrc_state'  2>/dev/null)"
    mv="$(  printf '%s' "$raw" | jsonfilter -e '@.supply_mv'  2>/dev/null)"
    tx="$(  printf '%s' "$raw" | jsonfilter -e '@.modem_tx'   2>/dev/null)"
    rx="$(  printf '%s' "$raw" | jsonfilter -e '@.modem_rx'   2>/dev/null)"

    dtx="?"; drx="?"
    if [ -n "$tx" ] && [ -n "$rx" ]; then
        [ -f "$COUNTERS_FILE" ] && read -r prev_tx prev_rx < "$COUNTERS_FILE"
        [ -n "$prev_tx" ] && [ -n "$prev_rx" ] && dtx=$(( tx - prev_tx )) && drx=$(( rx - prev_rx ))
        printf '%s %s' "$tx" "$rx" > "$COUNTERS_FILE"
    fi

    scc=""
    i=0
    while [ "$i" -lt 8 ]; do
        type="$(printf '%s' "$raw" | jsonfilter -e "@.ca[$i].type" 2>/dev/null)"
        [ -z "$type" ] && break
        if [ "$type" = "SCC" ]; then
            band="$( printf '%s' "$raw" | jsonfilter -e "@.ca[$i].band" 2>/dev/null)"
            crsrp="$(printf '%s' "$raw" | jsonfilter -e "@.ca[$i].rsrp" 2>/dev/null)"
            if [ -n "$crsrp" ]; then
                scc="${scc}b${band:-?}:active,"
            else
                scc="${scc}b${band:-?}:null,"
            fi
        fi
        i=$(( i + 1 ))
    done
    scc="${scc%,}"; scc="${scc:-none}"

    printf 'tech=%s rsrp=%sdBm sinr=%sdB rrc=%s mv=%smV tx+=%sB rx+=%sB scc=%s' \
        "${tech:-?}" "${rsrp:-?}" "${sinr:-?}" "${rrc:-?}" "${mv:-?}" "$dtx" "$drx" "$scc"
}

# Polls for connectivity recovery instead of blindly sleeping for the worst
# case: checks the WAN interface is up and a ping succeeds, every 3s up to
# max_wait seconds. Resumes as soon as recovery is confirmed and logs the
# measured recovery time either way, so the fixed cap only ever bounds
# duration — it no longer dictates it.
_wait_for_recovery() {
    local max_wait="$1" host="$2" start elapsed wan_up
    start="$(date +%s)"
    while :; do
        sleep 3
        wan_up="$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e '@.up' 2>/dev/null)"
        if [ "$wan_up" = "true" ] && ping -c 1 -W 3 "$host" > /dev/null 2>&1; then
            logger -t rm520n-watchdog "connectivity recovered after ~$(( $(date +%s) - start ))s"
            return 0
        fi
        elapsed=$(( $(date +%s) - start ))
        [ "$elapsed" -ge "$max_wait" ] && break
    done
    logger -t rm520n-watchdog "connectivity not confirmed within ${max_wait}s cap (waited ${elapsed}s)"
}

_trigger_reconnect() {
    logger -t rm520n-watchdog "threshold reached — action: reconnect [$(_signal_snapshot)]"
    printf '1' > "$STAGE_FILE"
    rm -f "$FAIL_FILE"
    ubus call rm520n reconnect
    _wait_for_recovery 30 "$host"
}

_trigger_reboot_modem() {
    logger -t rm520n-watchdog "threshold reached — action: reboot_modem [$(_signal_snapshot)]"
    printf '2' > "$STAGE_FILE"
    rm -f "$FAIL_FILE"
    ubus call rm520n reboot_modem
    _wait_for_recovery 60 "$host"
}

_trigger_reboot_router() {
    logger -t rm520n-watchdog "threshold reached — action: reboot_router (full system reboot) [$(_signal_snapshot)]"
    rm -f "$FAIL_FILE" "$STAGE_FILE"
    sync
    reboot
    # The process is about to be killed by the reboot itself — there is no
    # connectivity left to poll for from here, just a grace period so this
    # loop iteration doesn't race back into another trigger beforehand.
    sleep 120
}

while true; do
    [ -f /etc/config/rm520n ] || { sleep 30; continue; }

    enabled="$(_cfg enabled)"; [ "$enabled" = "1" ] || { sleep 30; continue; }

    host="$(_cfg ping_host)";        host="${host:-8.8.8.8}"
    threshold="$(_cfg fail_threshold)"; threshold="${threshold:-3}"
    action="$(_cfg action)";         action="${action:-reboot_modem}"
    interval="$(_cfg interval)";     interval="${interval:-10}"

    if ping -c 2 -W 3 "$host" > /dev/null 2>&1; then
        rm -f "$FAIL_FILE" "$STAGE_FILE"
        date +%s > "$LAST_OK_FILE"
        sleep "$interval"
        continue
    fi

    fails="$(cat "$FAIL_FILE" 2>/dev/null)"
    fails=$(( ${fails:-0} + 1 ))
    printf '%d' "$fails" > "$FAIL_FILE"
    logger -t rm520n-watchdog "ping $host failed ($fails/$threshold)"

    if [ "$fails" -lt "$threshold" ]; then
        sleep "$interval"
        continue
    fi

    case "$action" in
        cascade)
            stage="$(cat "$STAGE_FILE" 2>/dev/null)"; stage="${stage:-0}"
            case "$stage" in
                1) logger -t rm520n-watchdog "reconnect was ineffective — escalating"
                   _trigger_reboot_modem ;;
                2) logger -t rm520n-watchdog "reboot_modem was ineffective — escalating"
                   _trigger_reboot_router ;;
                *) _trigger_reconnect ;;
            esac
            ;;
        reboot_modem)
            _trigger_reboot_modem
            ;;
        reconnect)
            _trigger_reconnect
            ;;
        reboot_router)
            _trigger_reboot_router
            ;;
    esac
done
