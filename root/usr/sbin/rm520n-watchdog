#!/bin/sh
# Connectivity watchdog for rm520n — runs as a procd-managed daemon.
# Polls the configured host every <interval> seconds. On <threshold> consecutive
# failures triggers the configured action. Cascade mode escalates in three
# stages: reconnect -> reboot_modem -> reboot_router, one stage per threshold
# hit, as long as connectivity keeps failing.

FAIL_FILE="/tmp/rm520n_watchdog_fails"
STAGE_FILE="/tmp/rm520n_watchdog_stage"
LAST_OK_FILE="/tmp/rm520n_watchdog_last_ok"

_cfg() { uci -q get "rm520n.watchdog.$1" 2>/dev/null; }

# One-line signal snapshot (technology/RSRP/SINR/RRC state) taken via the
# existing rpcd refresh() call, so every logged action carries the connection
# state that led to it — makes the history log useful for diagnosing whether
# failures correlate with poor signal.
_signal_snapshot() {
    local raw tech rsrp sinr rrc
    raw="$(ubus call rm520n refresh 2>/dev/null)"
    if [ -z "$raw" ]; then
        printf 'signal=unavailable'
        return
    fi
    tech="$(printf '%s' "$raw" | jsonfilter -e '@.technology' 2>/dev/null)"
    rsrp="$(printf '%s' "$raw" | jsonfilter -e '@.rsrp'       2>/dev/null)"
    sinr="$(printf '%s' "$raw" | jsonfilter -e '@.sinr'       2>/dev/null)"
    rrc="$( printf '%s' "$raw" | jsonfilter -e '@.rrc_state'  2>/dev/null)"
    printf 'tech=%s rsrp=%sdBm sinr=%sdB rrc=%s' "${tech:-?}" "${rsrp:-?}" "${sinr:-?}" "${rrc:-?}"
}

_trigger_reconnect() {
    logger -t rm520n-watchdog "threshold reached — action: reconnect [$(_signal_snapshot)]"
    printf '1' > "$STAGE_FILE"
    rm -f "$FAIL_FILE"
    ubus call rm520n reconnect
    sleep 30
}

_trigger_reboot_modem() {
    logger -t rm520n-watchdog "threshold reached — action: reboot_modem [$(_signal_snapshot)]"
    printf '2' > "$STAGE_FILE"
    rm -f "$FAIL_FILE"
    ubus call rm520n reboot_modem
    sleep 60
}

_trigger_reboot_router() {
    logger -t rm520n-watchdog "threshold reached — action: reboot_router (full system reboot) [$(_signal_snapshot)]"
    rm -f "$FAIL_FILE" "$STAGE_FILE"
    sync
    reboot
    sleep 120
}

while true; do
    [ -f /etc/config/rm520n ] || { sleep 30; continue; }

    enabled="$(_cfg enabled)"; [ "$enabled" = "1" ] || { sleep 30; continue; }

    host="$(_cfg ping_host)";        host="${host:-8.8.8.8}"
    threshold="$(_cfg fail_threshold)"; threshold="${threshold:-3}"
    action="$(_cfg action)";         action="${action:-reboot_modem}"
    interval="$(_cfg interval)";     interval="${interval:-10}"

    if ping -c 2 -W 3 "$host" > /dev/null 2>&1; then
        rm -f "$FAIL_FILE" "$STAGE_FILE"
        date +%s > "$LAST_OK_FILE"
        sleep "$interval"
        continue
    fi

    fails="$(cat "$FAIL_FILE" 2>/dev/null)"
    fails=$(( ${fails:-0} + 1 ))
    printf '%d' "$fails" > "$FAIL_FILE"
    logger -t rm520n-watchdog "ping $host failed ($fails/$threshold)"

    if [ "$fails" -lt "$threshold" ]; then
        sleep "$interval"
        continue
    fi

    case "$action" in
        cascade)
            stage="$(cat "$STAGE_FILE" 2>/dev/null)"; stage="${stage:-0}"
            case "$stage" in
                1) logger -t rm520n-watchdog "reconnect was ineffective — escalating"
                   _trigger_reboot_modem ;;
                2) logger -t rm520n-watchdog "reboot_modem was ineffective — escalating"
                   _trigger_reboot_router ;;
                *) _trigger_reconnect ;;
            esac
            ;;
        reboot_modem)
            _trigger_reboot_modem
            ;;
        reconnect)
            _trigger_reconnect
            ;;
        reboot_router)
            _trigger_reboot_router
            ;;
    esac
done
